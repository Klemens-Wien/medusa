# URL of your Medusa backend. Leave empty to use the bundled sample data.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Publishable API key printed by the seed script
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# Optional: own hero video (mp4). Place a file in public/ or use a CDN URL.
NEXT_PUBLIC_HERO_VIDEO_URL=
